# Copy to .env and adjust. docker compose reads this file automatically.

# Secret used to sign and verify JWTs. Must be identical for every service.
JWT_SECRET=change-me-to-a-long-random-string

# Password of the demo accounts created by the seed scripts
# (director@erp.local and manager@erp.local).
DEMO_PASSWORD=admin123

# Only needed when running the services outside Docker (npm start):
# MONGO_URI=mongodb://localhost:27017/<service-name>
# AMQP_URL=amqp://localhost:5672
